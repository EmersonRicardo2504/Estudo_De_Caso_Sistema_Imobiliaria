def imprimir_informacoes(nome_cliente, tipo_alocacao, quarto_extra, garagem, valor_total, parcelas_imobiliaria, valor_parcelas):

    return print(f'\nNome do cliente: {nome_cliente}',
                 f'\nTipo de alocação: {tipo_alocacao}',
                 f'\nQuarto extra: {quarto_extra}',
                 f'\nGaragem: {garagem}',
                 f'\nValor total: R${valor_total:.2f}',
                 f'\nParcelas imobiliária: {parcelas_imobiliaria}', 
                 f'\nValor por parcela: R${valor_parcelas:.2f}\n')


def gerar_csv(nome_cliente, valor_total):

    with open('orcamento.csv', 'w', newline='', encoding='utf-8') as arquivo:

        escritor = csv.writer(arquivo)

        escritor.writerow(['Cliente', 'Parcela', 'Valor'])

        for parcela in range(1, 13):

            escritor.writerow([
                nome_cliente,
                parcela,
                f'{valor_total:.2f}'
            ])

    print('\n----- PARCELAS DO ORÇAMENTO -----')

    for parcela in range(1, 13):

        print(
            f'Cliente: {nome_cliente} | '
            f'Parcela: {parcela} | '
            f'Valor: R$ {valor_total:.2f}'
        )

    print('---------------------------------')
    print('\nArquivo orcamento.csv gerado com sucesso!')


imprimir_informacoes(nome_cliente, 
                     tipo_alocacao, 
                     quarto_extra, 
                     garagem, 
                     valor_total,
                     parcelas_imobiliaria,
                     valor_parcelas)


gerar_csv(nome_cliente, valor_total)




